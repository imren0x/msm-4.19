# Mi8953
CONFIG_MACH_XIAOMI_MSM8953=y
CONFIG_MACH_XIAOMI_ROSY=y
CONFIG_MACH_XIAOMI_TIFFANY=y
CONFIG_MACH_XIAOMI_YSL=y
CONFIG_MACH_XIAOMI_VINCE=y
CONFIG_MACH_XIAOMI_MIDO=y
CONFIG_MACH_XIAOMI_MARKW=y
CONFIG_MACH_XIAOMI_DAISY=y

# Camera
CONFIG_MSMB_CAMERA_LEGACY=y
CONFIG_MSMB_CAMERA_LEGACY_N=y

# FB console
CONFIG_CMDLINE="cgroup_disable=pressure console=tty0,115200 fbcon=rotate:1 fbcon=font:VGA8x8 core_ctl_disable_cpumask=0-7 kpti=0 cgroup.memory=nokmem,nosocket"
CONFIG_CMDLINE_FORCE=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_DUMMY_CONSOLE=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_HW_CONSOLE=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_CONSOLE_SLEEP=y
CONFIG_UNIX98_PTYS=y
CONFIG_FB_CMDLINE=y
CONFIG_FB_BOOT_VESA_SUPPORT=n
CONFIG_FB_CFB_FILLRECT=y
CONFIG_FB_CFB_COPYAREA=y
CONFIG_FB_CFB_IMAGEBLIT=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FB_MSM_CONSOLE=y
#CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y
CONFIG_FONT_8x16=y
CONFIG_FONT_8x8=y
CONFIG_FONTS=y
CONFIG_LOGO=y
CONFIG_LOGO_SUPERH_CLUT224=y

# Fingerprint
CONFIG_FINGERPRINT_FPC=y
CONFIG_FINGERPRINT_FPC1020=y
CONFIG_FINGERPRINT_FPC1020_ROSY=y
CONFIG_GOODIX_FINGERPRINT=y
CONFIG_FINGERPRINT_GOODIX_GF3208=y
CONFIG_FINGERPRINT_GOODIX_GF3208_VINCE=y
CONFIG_FINGERPRINT_GF3208_ROSY=y

# IR depen
CONFIG_MEDIA_RC_SUPPORT=y
CONFIG_RC_DEVICES=y

# IR
CONFIG_SPI_PEELIR=y
CONFIG_IR_PWM_MI8953=y
CONFIG_RC_CORE=y
CONFIG_RC_MAP=y
CONFIG_RC_DECODERS=y
CONFIG_LIRC=y
CONFIG_IR_LIRC_CODEC=y
# CONFIG_USER_RC_INPUT is not set
# CONFIG_USER_SP_RC_INPUT is not set
CONFIG_IR_NEC_DECODER=y
CONFIG_IR_RC5_DECODER=y
CONFIG_IR_RC6_DECODER=y
CONFIG_IR_JVC_DECODER=y
CONFIG_IR_SONY_DECODER=y
CONFIG_IR_RC5_SZ_DECODER=y
CONFIG_IR_SANYO_DECODER=y
# CONFIG_IR_MCE_KBD_DECODER is not set
# CONFIG_IR_DUMP_DECODER is not set
CONFIG_RC_DEVICES=y
# CONFIG_RC_ATI_REMOTE is not set
# CONFIG_IR_IMON is not set
# CONFIG_IR_MCEUSB is not set
# CONFIG_IR_REDRAT3 is not set
# CONFIG_IR_STREAMZAP is not set
# CONFIG_IR_IGUANA is not set
# CONFIG_IR_TTUSBIR is not set
# CONFIG_RC_LOOPBACK is not set
# CONFIG_IR_GPIO_CIR is not set
# CONFIG_IR_GPIO is not set
# CONFIG_IR_MSM_GENI is not set

# Leds
CONFIG_LEDS_AW2013_MI8953=y
CONFIG_LEDS_QPNP=y
CONFIG_LEDS_QPNP_WLED=y

# TAS2557
CONFIG_SND_SOC_TAS2557=y
CONFIG_TAS2557_REGMAP=y
CONFIG_TAS2557_CODEC=y
CONFIG_TAS2557_MISC=y

# MAX98927
CONFIG_SND_SOC_MAX98927=y

# Touchscreen
CONFIG_TOUCHSCREEN_SYSCTL_MI8953=y
CONFIG_TOUCHSCREEN_DOUBLETAP2WAKE=y
CONFIG_TOUCHSCREEN_SWEEP2WAKE=y
CONFIG_TOUCHSCREEN_FTS_MI8953=y
# CONFIG_TOUCHSCREEN_FT5446=y
CONFIG_TOUCHSCREEN_GT9XX=y
CONFIG_TOUCHSCREEN_TD4310_E7=y
CONFIG_TOUCHSCREEN_TD4310_LANSI_E7=y
CONFIG_TOUCHSCREEN_NT36XXX=y
CONFIG_TOUCHSCREEN_NT36XXX_I2C=y
CONFIG_TOUCHSCREEN_IST3038C=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_I2C=y
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_SPI is not set
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_CORE=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_RMI_DEV=y
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_FW_UPDATE is not set
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_GESTURE=y
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_PROXIMITY is not set
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_TEST_REPORTING=y

# Certificates for signature checking
CONFIG_SYSTEM_TRUSTED_KEYS="verity.x509.pem"

# SCSI Transports
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_BLK_DEV_MD=y
CONFIG_MD_LINEAR=y
# CONFIG_DM_DEFAULT_KEY is not set
CONFIG_DM_ANDROID_VERITY=y
CONFIG_MODULE_FORCE_UNLOAD=y

# USB
CONFIG_QPNP_TYPEC=y
CONFIG_USB_DWC3_MSM_LEGACY=y

# Vibrator
CONFIG_LEDS_QPNP_HAPTICS=y